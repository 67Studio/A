			if activeTab ~= record then tween(row, { BackgroundTransparency = 0.6 }) end
		end)
		row.MouseLeave:Connect(function()
			tween(row, { BackgroundTransparency = activeTab == record and 0.7 or 1 })
		end)
		row.Activated:Connect(function()
			tabObj:Enable()
		end)

		function tabObj:Enable()
			if activeTab == record then return end
			if activeTab then
				activeTab.paint(false)
				activeTab.page.Visible = false
			end
			activeTab = record
			page.Position = UDim2.fromOffset(0, 12)
			page.Visible = true
			tween(page, { Position = UDim2.fromOffset(0, 0) }, 0.3)
			record.paint(true)
		end

		function tabObj:Disable()
			record.paint(false)
			page.Visible = false
			if activeTab == record then activeTab = nil end
		end

		function tabObj:Visible(state)
			if state == nil then state = not row.Visible end
			row.Visible = state
			if not state and activeTab == record then
				tabObj:Disable()
				for _, other in ipairs(tabs) do
					if other ~= record and other.row.Visible then
						other.api:Enable()
						break
					end
				end
			end
		end

		function tabObj:Destroy()
			local idx = table.find(tabs, record)
			if idx then table.remove(tabs, idx) end
			local wasActive = activeTab == record
			if wasActive then activeTab = nil end
			row:Destroy()
			page:Destroy()
			if wasActive and tabs[1] then tabs[1].api:Enable() end
		end

		local function finish(element)
			local api = {}
			function api:Visible(state)
				if state == nil then state = not element.Visible end
				element.Visible = state
			end
			function api:Destroy()
				element:Destroy()
			end
			return api
		end

