local function newSignal(name)
	local handlers = {}
	local sig = { Name = name }

	local function add(fn, once)
		if type(fn) ~= "function" then return nil end
		local handle = { Connected = true, fn = fn, once = once }
		function handle:Disconnect()
			if not self.Connected then return end
			self.Connected = false
			local idx = table.find(handlers, self)
			if idx then table.remove(handlers, idx) end
		end
		table.insert(handlers, handle)
		return handle
	end

	function sig:Connect(fn) return add(fn, false) end
	function sig:Once(fn) return add(fn, true) end

	function sig:_fire(...)
		for _, handle in ipairs(table.clone(handlers)) do
			if handle.once then handle:Disconnect() end
			task.spawn(handle.fn, ...)
		end
	end

	return sig
end

local signals = {}
local Bus = {}
for _, name in ipairs({ "FlagsChanged", "ThemeChanged", "FileSaved", "OptionAdded" }) do
	signals[name] = newSignal(name)
	Bus[name] = signals[name]
end

function Bus:FireConnection(name, ...)
	local sig = signals[type(name) == "table" and name.Name or name]
	if sig then sig:_fire(...) end
end

