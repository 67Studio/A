			local function syncFlag()
				local v = currentValue()
				setFlag(flag, multi and v or (v or ""))
			end

			local function pushValue()
				syncFlag()
				fire(cbs, currentValue())
			end

			local isOpen = false

			local function panelHeight()
				local baseH = math.clamp(#optionList, 1, 8) * 24 + 8
				if searchable then baseH += 30 end
				return baseH
			end

			local function closePanel()
				if not isOpen then return end
				isOpen = false
				catcher.Visible = false
				tween(arrow, { Rotation = 0 })
				setKind(arrow, "TextMuted")
				if searchBox then
					currentSearchText = ""
					searchBox.Text = ""
				end
			end
			table.insert(popups, closePanel)

			local function openPanel()
				if isOpen then return end
				isOpen = true
				local h = panelHeight()
				local s = scaler.Scale
				local pos, size = pill.AbsolutePosition / s, pill.AbsoluteSize / s
				local screen = screenSize()
				local below = pos.Y + size.Y + 4 + h <= screen.Y
				panel.AnchorPoint = Vector2.new(0, below and 0 or 1)
				panel.Position = UDim2.fromOffset(
					math.clamp(pos.X, 0, math.max(0, screen.X - 150)),
					below and (pos.Y + size.Y + 4) or (pos.Y - 4)
				)
				panel.Size = UDim2.fromOffset(150, 0)
				catcher.Visible = true
				tween(panel, { Size = UDim2.fromOffset(150, h) })
				tween(arrow, { Rotation = 180 })
				setKind(arrow, "Accent")
				if searchBox then
					searchBox.Text = ""
					currentSearchText = ""
				end
			end

			local function choose(n)
				if multi then
					selected[n] = (not selected[n]) or nil
				else
					selected = { [n] = true }
				end
				refreshMarks()
				pushValue()
				if not multi then closePanel() end
			end

			local function rebuildOptions(filterText)
				for _, ui in pairs(optionUI) do
					ui.btn:Destroy()
				end
				optionUI = {}
				local count = 0
				for i, n in ipairs(optionList) do
					local matches = filterText == "" or string.find(string.lower(n), string.lower(filterText), 1, true)
					if matches then
						count = count + 1
						local btn = tag(mk("TextButton", {
							Name = "Option",
							Size = UDim2.new(1, 0, 0, 22),
							BackgroundTransparency = 1,
							LayoutOrder = i,
							Parent = scroll,
						}), "Frame")
						build("round", btn, 4)
						local bar = tag(mk("Frame", {
							Size = UDim2.fromOffset(3, 0),
							AnchorPoint = Vector2.new(0, 0.5),
							Position = UDim2.new(0, 2, 0.5, 0),
							BackgroundTransparency = 1,
							Parent = btn,
						}), "Accent")
						build("round", bar, 2)
						local lbl = build("caption", btn, {
							Text = n,
							Font = Enum.Font.GothamBold,
							TextSize = 10,
							Position = UDim2.fromOffset(10, 0),
							Size = UDim2.new(1, -14, 1, 0),
							TextTruncate = Enum.TextTruncate.AtEnd,
						}, "TextMuted")
						btn.MouseEnter:Connect(function()
							tween(btn, { BackgroundTransparency = 0.4 })
						end)
						btn.MouseLeave:Connect(function()
							tween(btn, { BackgroundTransparency = 1 })
						end)
						btn.Activated:Connect(function()
							choose(n)
						end)
						optionUI[n] = { btn = btn, bar = bar, label = lbl }
						Bus:FireConnection("OptionAdded", name, n)
					end
				end
				normalize()
				refreshMarks()

				if isOpen then
					local newH = math.clamp(count, 1, 8) * 24 + 8
					if searchable then newH += 30 end
					tween(panel, { Size = UDim2.fromOffset(150, newH) })
				end
			end

			rebuildOptions("")
			syncFlag()
			task.defer(function()
				fire(cbs, currentValue())
			end)

			if searchBox then
				searchBox:GetPropertyChangedSignal("Text"):Connect(function()
					currentSearchText = searchBox.Text
					rebuildOptions(currentSearchText)
				end)
			end

			row2.Activated:Connect(function()
				if isOpen then closePanel() else openPanel() end
			end)
			catcher.Activated:Connect(closePanel)

			local dropdown = finish(row2)
			function dropdown:Destroy()
				closePanel()
				catcher:Destroy()
				row2:Destroy()
			end
			function dropdown:Callback(fn)
				if type(fn) == "function" then table.insert(cbs, fn) end
			end
			function dropdown:Select(option)
				local n = tostring(option)
				if not table.find(optionList, n) then return end
				if multi then selected[n] = true else selected = { [n] = true } end
				refreshMarks()
				pushValue()
			end
			function dropdown:Set(a, add)
				if type(a) == "function" then
					table.clear(cbs)
					cbs[1] = a
				elseif type(a) == "table" then
					local newList = listOptions(a)
					if add then
						for _, n in ipairs(newList) do
							if not table.find(optionList, n) then table.insert(optionList, n) end
						end
					else
						optionList = newList
						selected = {}
					end
					rebuildOptions(currentSearchText)
					normalize()
					pushValue()
				elseif a ~= nil then
					dropdown:Select(a)
				end
			end
			function dropdown:Add(...)
				local added = { ... }
				if type(added[1]) == "table" then added = listOptions(added[1]) end
				for _, option in ipairs(added) do
					local n = tostring(option)
					if not table.find(optionList, n) then table.insert(optionList, n) end
				end
				rebuildOptions(currentSearchText)
			end
			function dropdown:Remove(option)
				local n = tostring(option)
				local idx = table.find(optionList, n)
				if idx then
					table.remove(optionList, idx)
					selected[n] = nil
					rebuildOptions(currentSearchText)
					pushValue()
				end
			end
			return dropdown
		end

		function tabObj:AddTextBox(xcfg)
			local name = field(xcfg, 1, "Name", "Title") or "Text Box"
			local desc = field(xcfg, nil, "Description", "Desc")
			local default = field(xcfg, 2, "Default")
			local clear = field(xcfg, 3, "ClearText") == true
			local cbs = toCallbacks(field(xcfg, 4, "Callback"))
			local placeholder = tostring(field(xcfg, 5, "PlaceholderText", "Placeholder") or "Input")
			local flag = field(xcfg, nil, "Flag")
			local text = type(default) == "string" and default or ""
			if hasFlag(flag) and type(lib.Flags[flag]) == "string" then text = lib.Flags[flag] end

			local row2, labels = build("row", page, name, desc, 178, true)
			row2.LayoutOrder = nextOrder()

			local pill = tag(mk("Frame", {
				Size = UDim2.fromOffset(150, 18),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Parent = row2,
			}), "Stroke")
			build("round", pill, 4)
			local pencil = tag(mk("ImageLabel", {
				Size = UDim2.fromOffset(12, 12),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -5, 0.5, 0),
				BackgroundTransparency = 1,
				Image = lib:GetIcon("pencil"),
				Parent = pill,
			}), "TextMuted")

			local box = mk("TextBox", {
				Size = UDim2.new(1, -26, 1, 0),
				Position = UDim2.fromOffset(8, 0),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = clear,
				ClipsDescendants = true,
				PlaceholderText = placeholder,
				Text = text,
				Parent = pill,
			})
			tag(box, "Text")
			tag(box, "TextMuted", "PlaceholderColor3")

			local textbox = finish(row2)
			textbox.OnChanging = false

			local function commit()
				local v = box.Text
				if textbox.OnChanging and type(textbox.OnChanging) == "function" then
					v = textbox.OnChanging(v) or v
					box.Text = v
				end
				setFlag(flag, v)
				fire(cbs, v)
			end

			box.Focused:Connect(function()
				setKind(pencil, "Accent")
			end)
			box.FocusLost:Connect(function()
				setKind(pencil, "TextMuted")
				commit()
			end)
			row2.Activated:Connect(function()
				box:CaptureFocus()
			end)

			setFlag(flag, box.Text)
			if box.Text ~= "" then
				task.defer(function()
					fire(cbs, box.Text)
				end)
			end

			function textbox:Callback(fn)
				if type(fn) == "function" then table.insert(cbs, fn) end
			end
			function textbox:Set(a, b)
				if type(a) == "function" then
					table.clear(cbs)
					cbs[1] = a
				elseif a ~= nil then
					box.Text = tostring(a)
					commit()
				end
			end
			return textbox
		end

		function tabObj:AddDiscordInvite(icfg)
			local cardTitle = tostring(field(icfg, 1, "Title", "Name") or "Discord")
			local cardDesc = tostring(field(icfg, nil, "Description", "Desc") or "")
			local logo = field(icfg, 2, "Logo") or ""
			local invite = tostring(field(icfg, 3, "Invite") or "")

			local holder = mk("Frame", {
				Name = "Option",
				Size = UDim2.new(1, 0, 0, 92),
				BackgroundTransparency = 1,
				LayoutOrder = nextOrder(),
				Parent = page,
			})
			build("caption", holder, {
				Text = invite,
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				Position = UDim2.fromOffset(2, 0),
				Size = UDim2.new(1, -2, 0, 14),
			}, "Accent")

			local card = tag(mk("Frame", {
				Size = UDim2.new(1, 0, 0, 74),
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Parent = holder,
			}), "Frame")
			build("round", card, 6)
			build("outline", card, "Stroke")

			local logoImage = mk("ImageLabel", {
				Size = UDim2.fromOffset(32, 32),
				Position = UDim2.fromOffset(8, 8),
				BackgroundTransparency = 1,
				Image = tostring(logo),
				Parent = card,
			})
			build("round", logoImage, 4)

			local titleL = build("caption", card, {
				Text = cardTitle,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				Position = UDim2.fromOffset(48, 8),
				Size = UDim2.new(1, -56, 0, 14),
			}, "Text")
			local descL = build("caption", card, {
				Text = cardDesc,
				TextSize = 9,
				Position = UDim2.fromOffset(48, 23),
				Size = UDim2.new(1, -56, 0, 14),
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, "TextMuted")

			local join = mk("TextButton", {
				Text = "Join",
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextColor3 = Color3.new(1, 1, 1),
				Size = UDim2.new(1, -16, 0, 20),
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -8),
				Parent = card,
			})
			tag(join, "Success")
			build("round", join, 5)

			local busy = false
			join.Activated:Connect(function()
				if busy then return end
				busy = true
				local copied = pcall(setclipboard, invite)
				join.Text = copied and "Copied to Clipboard" or "Clipboard unavailable"
				setKind(join, copied and "Accent" or "Danger")
				task.delay(4, function()
					join.Text = "Join"
					setKind(join, "Success")
					busy = false
				end)
			end)

			local invitation = finish(holder)
			function invitation:Set(a, b)
				if type(a) == "string" then titleL.Text = a end
				if type(b) == "string" then descL.Text = b end
			end
			return invitation
		end

		table.insert(tabs, record)
		table.insert(lib.Tabs, { TabInfo = { Name = name, Icon = icon or false }, func = tabObj, Cont = page })
		if #tabs == 1 then tabObj:Enable() end
		return tabObj
	end

	return win
end

return lib
