		function tabObj:AddSlider(scfg)
			local name = field(scfg, 1, "Name", "Title") or "Slider!"
			local desc = field(scfg, nil, "Description", "Desc")
			local minV = tonumber(field(scfg, 2, "MinValue", "Min")) or 0
			local maxV = tonumber(field(scfg, 3, "MaxValue", "Max")) or 100
			local step = tonumber(field(scfg, 4, "Increase", "Step")) or 1
			local value = tonumber(field(scfg, 5, "Default")) or minV
			local cbs = toCallbacks(field(scfg, 6, "Callback"))
			local flag = field(scfg, 7, "Flag")
			if hasFlag(flag) then value = tonumber(lib.Flags[flag]) or value end
			if maxV <= minV then maxV = minV + 1 end
			if step <= 0 then step = 1 end

			local function snap(v)
				v = math.clamp(v, minV, maxV)
				v = minV + math.floor((v - minV) / step + 0.5) * step
				v = math.clamp(v, minV, maxV)
				return tonumber(string.format("%.8g", v))
			end
			value = snap(value)

			local row2, labels = build("row", page, name, desc, 110, true)
			row2.LayoutOrder = nextOrder()

			local right = mk("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(110, 20),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Parent = row2,
			})

			local hit = mk("TextButton", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -30, 1, 0),
				Parent = right,
			})

			local track = tag(mk("Frame", {
				Size = UDim2.new(1, 0, 0, 5),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Parent = hit,
			}), "Stroke")
			build("round", track, 3)
			local fill = tag(mk("Frame", { Size = UDim2.fromScale(0, 1), Parent = track }), "Accent")
			build("round", fill, 3)
			local knob = tag(mk("Frame", {
				Size = UDim2.fromOffset(7, 12),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				Parent = track,
			}), "Text")
			build("round", knob, 3)

			local valueLabel = build("caption", right, {
				Text = tostring(value),
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Right,
				Size = UDim2.new(0, 28, 1, 0),
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
			}, "Accent")
			local popScale = mk("UIScale", { Parent = valueLabel })
			local popId = 0

			local function pop()
				popId += 1
				local id = popId
				popScale.Scale = 0.85
				tween(popScale, { Scale = 1.1 }, 0.1)
				task.delay(0.1, function()
					if id == popId then tween(popScale, { Scale = 1 }, 0.1) end
				end)
			end

			local function render()
				local frac = (value - minV) / (maxV - minV)
				fill.Size = UDim2.new(frac, 0, 1, 0)
				knob.Position = UDim2.new(frac, 0, 0.5, 0)
				local text = tostring(value)
				if text ~= valueLabel.Text then
					valueLabel.Text = text
					pop()
				end
			end
			render()

			local function commit(v)
				v = snap(v)
				if v == value then return end
				value = v
				render()
				setFlag(flag, value)
				fire(cbs, value)
			end

			local function fromX(x)
				local frac = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				commit(minV + frac * (maxV - minV))
			end

			local dragConn = bindDrag(trash, hit, {
				start = function(pos)
					page.ScrollingEnabled = false
					fromX(pos.X)
				end,
				move = function(_, pos)
					fromX(pos.X)
				end,
				finish = function()
					page.ScrollingEnabled = true
				end,
			})

			setFlag(flag, value)
			task.defer(function()
				fire(cbs, value)
			end)

			local slider = finish(row2)
			function slider:Destroy()
				dragConn:Disconnect()
				row2:Destroy()
			end
			function slider:Callback(fn)
				if type(fn) == "function" then table.insert(cbs, fn) end
			end
			function slider:Set(a, b)
				if type(a) == "number" then
					commit(a)
				elseif type(a) == "string" then
					labels.setTitle(a)
					if type(b) == "string" then labels.setDesc(b) end
				elseif type(a) == "function" then
					table.clear(cbs)
					cbs[1] = a
				end
			end
			return slider
		end

		function tabObj:AddDropdown(dcfg)
			local name = field(dcfg, 1, "Name", "Title") or "Dropdown"
			local desc = field(dcfg, nil, "Description", "Desc")
			local optionList = listOptions(field(dcfg, 2, "Options"))
			local default = field(dcfg, 3, "Default")
			local cbs = toCallbacks(field(dcfg, 4, "Callback"))
			local flag = field(dcfg, 5, "Flag")
			local multi = field(dcfg, nil, "MultiSelect") == true
			local searchable = field(dcfg, nil, "Searchable") == true

			local selected = {}
			local optionUI = {}
			local currentSearchText = ""

			local function ingest(source)
				selected = {}
				if type(source) == "string" or type(source) == "number" then
					selected[tostring(source)] = true
				elseif type(source) == "table" then
					for k, v in pairs(source) do
						if type(k) == "number" then
							selected[tostring(v)] = true
						elseif v then
							selected[tostring(k)] = true
						end
					end
				end
			end

			local function normalize()
				local kept, any = {}, false
				for _, n in ipairs(optionList) do
					if selected[n] and (multi or not any) then
						kept[n] = true
						any = true
					end
				end
				selected = kept
			end

			local function currentValue()
				if multi then
					local map = {}
					for _, n in ipairs(optionList) do
						map[n] = selected[n] == true
					end
					return map
				end
				for _, n in ipairs(optionList) do
					if selected[n] then return n end
				end
				return nil
			end

			local function labelText()
				local names = {}
				for _, n in ipairs(optionList) do
					if selected[n] then table.insert(names, n) end
				end
				return #names > 0 and table.concat(names, ", ") or "..."
			end

			ingest(hasFlag(flag) and lib.Flags[flag] or default)
			normalize()

			local row2, labels = build("row", page, name, desc, 178, true)
			row2.LayoutOrder = nextOrder()

			local pill = tag(mk("Frame", {
				Size = UDim2.fromOffset(150, 18),
