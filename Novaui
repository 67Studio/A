		end

		function record.paint(on)
			setKind(label, on and "Text" or "TextMuted")
			if img then setKind(img, on and "Text" or "TextMuted") end
			tween(bar, {
				Size = UDim2.fromOffset(3, on and 14 or 0),
				BackgroundTransparency = on and 0 or 1,
			})
			tween(row, { BackgroundTransparency = on and 0.7 or 1 })
		end

