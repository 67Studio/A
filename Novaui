local palette = lib.Themes[lib.Save.Theme]

local KIND_KEY = {
	Gradient = "gradient",
	Frame = "panel",
	Elevated = "elevated",
	Stroke = "stroke",
	Text = "text",
	TextMuted = "muted",
	Accent = "accent",
	Success = "success",
	Danger = "danger",
	Warning = "warning",
	ScrollBar = "accent",
}

local function colorOf(kind)
	return palette[KIND_KEY[kind]] or palette.accent
end

local function defaultProp(inst, kind)
	if inst:IsA("UIStroke") or inst:IsA("UIGradient") then return "Color" end
	if kind == "ScrollBar" then return "ScrollBarImageColor3" end
	if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then return "ImageColor3" end
	if inst:IsA("TextLabel") or inst:IsA("TextBox") then return "TextColor3" end
	return "BackgroundColor3"
end

local tweenSlots = setmetatable({}, { __mode = "k" })

local function tween(inst, props, duration)
	local info = duration and TweenInfo.new(duration, Enum.EasingStyle.Quint) or DEFAULT_INFO
	local slots = tweenSlots[inst]
	if not slots then
		slots = {}
		tweenSlots[inst] = slots
	end
	local last
	for prop, value in pairs(props) do
		local running = slots[prop]
		if running then running:Cancel() end
		local tw = TweenService:Create(inst, info, { [prop] = value })
		slots[prop] = tw
		tw:Play()
		last = tw
	end
	return last
end

local function tag(inst, kind, prop)
	prop = prop or defaultProp(inst, kind)
	local rec = lib.Instances[inst]
	if not rec then
		rec = {}
		lib.Instances[inst] = rec
		inst.Destroying:Connect(function()
			lib.Instances[inst] = nil
		end)
	end
	rec[prop] = kind
	inst[prop] = colorOf(kind)
	return inst
end

local function setKind(inst, kind, prop)
	prop = prop or defaultProp(inst, kind)
	local rec = lib.Instances[inst]
	if rec then rec[prop] = kind end
	tween(inst, { [prop] = colorOf(kind) })
end

local function repaint()
	for inst, props in pairs(lib.Instances) do
		for prop, kind in pairs(props) do
			inst[prop] = colorOf(kind)
		end
	end
end

local function apply(inst, props)
	if props then
		for k, v in pairs(props) do
			inst[k] = v
		end
	end
	return inst
end

local function mk(class, props, children)
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
	if inst:IsA("GuiButton") then inst.AutoButtonColor = false end
	if class == "TextButton" then inst.Text = "" end
	local parent
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then inst.Parent = parent end
	return inst
end

