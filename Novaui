		local corner = build("round", btn, mcfg.Circle == false and 10 or size)
		local stroke = build("outline", btn, "Accent", 2)
		apply(btn, btnProps)
		apply(corner, mcfg.Corner)
		apply(stroke, mcfg.Stroke)

		btn.MouseEnter:Connect(function()
			tween(floatScale, { Scale = 1.08 })
		end)
		btn.MouseLeave:Connect(function()
			tween(floatScale, { Scale = 1 })
		end)

		local function syncFloat()
			if alwaysVisible then
				btn.Visible = true
				return
			end
			local show = not shell.Visible
			if show and not btn.Visible then
				floatScale.Scale = 0.5
				btn.Visible = true
				tween(floatScale, { Scale = 1 })
			else
				btn.Visible = show
			end
		end
		shell:GetPropertyChangedSignal("Visible"):Connect(syncFloat)

		local origin, moved = nil, false
		bindDrag(trash, btn, {
			start = function()
				origin = Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset)
				moved = false
			end,
			move = function(delta)
				if delta.Magnitude > 5 then moved = true end
				local s = scaler.Scale
				local screen = screenSize()
				btn.Position = UDim2.fromOffset(
					math.clamp(origin.X + delta.X / s, 0, math.max(0, screen.X - size)),
					math.clamp(origin.Y + delta.Y / s, 0, math.max(0, screen.Y - size))
				)
			end,
		})
		btn.Activated:Connect(function()
			if moved then
				moved = false
				return
			end
			win:Minimize()
		end)

		return { Button = btn, Corner = corner, Stroke = stroke, SetImage = setImage }
	end

