function lib:SetTheme(name)
	local theme = lib.Themes[name]
	if type(theme) ~= "table" then return false end
	for _, key in pairs(KIND_KEY) do
		if theme[key] == nil then return false end
	end
	lib.Save.Theme = name
	palette = theme
	writeJson(SAVE_FILE, lib.Save)
	Bus:FireConnection("ThemeChanged", name)
	repaint()
	return true
end

function lib:SetScale(px)
	px = tonumber(px)
	if not px then return end
	lib._virtualHeight = math.clamp(px, 300, 2000)
	for scaler in pairs(scalers) do
		if scaler.Parent then
			scaler.Scale = calcScale()
		else
			scalers[scaler] = nil
		end
	end
end

function lib:GetIcon(name)
	if type(name) == "number" then return "rbxassetid://" .. math.floor(name) end
	if type(name) ~= "string" or name == "" then return "" end
	if name:find("rbxassetid://", 1, true) or name:find("rbxasset://", 1, true) then return name end
	local key = name:lower():gsub("^lucide[:%-_%s]*", ""):gsub("[%s%-_]", "")
	if key:match("^%d+$") then return "rbxassetid://" .. key end
	return lib.Icons[key] or lib.Icons.circle
end

local function resolveImage(img)
	if type(img) == "string" and img:match("^https?://") then
		local hash = 5381
		for i = 1, #img do
			hash = (hash * 33 + img:byte(i)) % 4294967296
		end
		local file = ("novaui_%x.png"):format(hash)
		local ok, asset = pcall(function()
			if not isfile(file) then writefile(file, game:HttpGet(img)) end
			return (getcustomasset or getsynasset)(file)
		end)
		if ok and type(asset) == "string" then return asset end
		return ""
	end
	return lib:GetIcon(img)
end

