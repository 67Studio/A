			row2.Activated:Connect(function()
				box:CaptureFocus()
			end)

			setFlag(flag, box.Text)
			if box.Text ~= "" then
				task.defer(function()
					fire(cbs, box.Text)
				end)
			end

			function textbox:Callback(fn)
				if type(fn) == "function" then table.insert(cbs, fn) end
			end
			function textbox:Set(a, b)
				if type(a) == "function" then
					table.clear(cbs)
					cbs[1] = a
				elseif a ~= nil then
					box.Text = tostring(a)
					commit()
				end
			end
			return textbox
		end

		function tabObj:AddDiscordInvite(icfg)
			local cardTitle = tostring(field(icfg, 1, "Title", "Name") or "Discord")
			local cardDesc = tostring(field(icfg, nil, "Description", "Desc") or "")
			local logo = field(icfg, 2, "Logo") or ""
			local invite = tostring(field(icfg, 3, "Invite") or "")

			local holder = mk("Frame", {
				Name = "Option",
				Size = UDim2.new(1, 0, 0, 92),
				BackgroundTransparency = 1,
				LayoutOrder = nextOrder(),
				Parent = page,
			})
			build("caption", holder, {
				Text = invite,
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				Position = UDim2.fromOffset(2, 0),
				Size = UDim2.new(1, -2, 0, 14),
			}, "Accent")

			local card = tag(mk("Frame", {
				Size = UDim2.new(1, 0, 0, 74),
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Parent = holder,
			}), "Frame")
			build("round", card, 6)
			build("outline", card, "Stroke")

			local logoImage = mk("ImageLabel", {
				Size = UDim2.fromOffset(32, 32),
				Position = UDim2.fromOffset(8, 8),
				BackgroundTransparency = 1,
				Image = tostring(logo),
				Parent = card,
			})
			build("round", logoImage, 4)

			local titleL = build("caption", card, {
				Text = cardTitle,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				Position = UDim2.fromOffset(48, 8),
				Size = UDim2.new(1, -56, 0, 14),
			}, "Text")
			local descL = build("caption", card, {
				Text = cardDesc,
				TextSize = 9,
				Position = UDim2.fromOffset(48, 23),
				Size = UDim2.new(1, -56, 0, 14),
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, "TextMuted")

			local join = mk("TextButton", {
				Text = "Join",
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextColor3 = Color3.new(1, 1, 1),
				Size = UDim2.new(1, -16, 0, 20),
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -8),
				Parent = card,
			})
			tag(join, "Success")
			build("round", join, 5)

			local busy = false
			join.Activated:Connect(function()
				if busy then return end
				busy = true
				local copied = pcall(setclipboard, invite)
				join.Text = copied and "Copied to Clipboard" or "Clipboard unavailable"
				setKind(join, copied and "Accent" or "Danger")
				task.delay(4, function()
					join.Text = "Join"
					setKind(join, "Success")
					busy = false
				end)
			end)

			local invitation = finish(holder)
			function invitation:Set(a, b)
				if type(a) == "string" then titleL.Text = a end
				if type(b) == "string" then descL.Text = b end
			end
			return invitation
		end

		table.insert(tabs, record)
		table.insert(lib.Tabs, { TabInfo = { Name = name, Icon = icon or false }, func = tabObj, Cont = page })
		if #tabs == 1 then tabObj:Enable() end
		return tabObj
	end

	return win
end

return lib
