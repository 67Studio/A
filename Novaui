local function field(cfg, index, ...)
	if type(cfg) ~= "table" then return nil end
	if index ~= nil and cfg[index] ~= nil then return cfg[index] end
	for _, key in ipairs({ ... }) do
		if cfg[key] ~= nil then return cfg[key] end
	end
	return nil
end

local function toCallbacks(fn)
	local list = {}
	if type(fn) == "function" then
		list[1] = fn
	elseif type(fn) == "table" and fn[1] ~= nil and fn[2] ~= nil then
		list[1] = function(value)
			fn[1][fn[2]] = value
		end
	end
	return list
end

local function fire(list, ...)
	for _, fn in ipairs(list) do
		task.spawn(fn, ...)
	end
end

local function listOptions(opts)
	local list = {}
	if type(opts) ~= "table" then return list end
	if #opts > 0 then
		for _, v in ipairs(opts) do
			table.insert(list, tostring(v))
		end
	else
		for k in pairs(opts) do
			table.insert(list, tostring(k))
		end
		table.sort(list)
	end
	return list
end

local pendingWrite = false

local function hasFlag(name)
	return type(name) == "string" and lib.Flags[name] ~= nil
end

local function setFlag(name, value)
	if type(name) ~= "string" then return end
	if lib.Flags[name] == value and type(value) ~= "table" then return end
	lib.Flags[name] = value
	Bus:FireConnection("FlagsChanged", name, value)
	if pendingWrite then return end
	pendingWrite = true
	task.delay(0.1, function()
		pendingWrite = false
		local file = lib.Settings.ScriptFile
		if type(file) ~= "string" then return end
		local ok, encoded = writeJson(file, lib.Flags)
		if ok then Bus:FireConnection("FileSaved", "Script-Flags", file, encoded) end
	end)
end

local function loadFlags()
	local file = lib.Settings.ScriptFile
	if type(file) ~= "string" then return end
	local data = readJson(file)
	if type(data) == "table" then
		for k, v in pairs(data) do
			lib.Flags[k] = v
		end
	end
end

local function bindDrag(trash, handle, handlers)
	local active, origin, current = false, nil, nil

	handle.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then return end
		active, origin, current = true, input.Position, input
		if handlers.start then handlers.start(input.Position) end
		local watcher
		watcher = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				watcher:Disconnect()
				if active then
					active = false
					if handlers.finish then handlers.finish() end
				end
			end
		end)
	end)

	local conn = UserInputService.InputChanged:Connect(function(input)
		if not active then return end
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement or (kind == Enum.UserInputType.Touch and input == current) then
			handlers.move(input.Position - origin, input.Position)
		end
	end)
	table.insert(trash, conn)
	return conn
end

