local notifyOrder = 0

function lib:Notify(cfg)
	cfg = type(cfg) == "table" and cfg or {}
	local title = tostring(cfg.Title or cfg[1] or "Nova")
	local text = tostring(cfg.Text or cfg[2] or "")
	local duration = tonumber(cfg.Duration or cfg[3]) or 4
	local isSuccess = cfg.Success == true
	local isWarning = cfg.Warning == true
	local isDanger = cfg.Danger == true

	notifyOrder += 1
	local order = notifyOrder

	local holder = getNotifyHolder()

	-- Card wrapper
	local card = mk("Frame", {
		Name = "Notify",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = holder,
	})

	local inner = mk("Frame", {
		Name = "Inner",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(60, 0), -- empieza fuera para slide-in
		BackgroundTransparency = 1,
		Parent = card,
	})
	tag(inner, "Elevated")
	build("round", inner, 8)
	local stroke = build("outline", inner, "Stroke", 1)
	stroke.Transparency = 0

	-- Barra de color lateral
	local accentKind = isSuccess and "Success" or (isDanger and "Danger") or (isWarning and "Warning") or "Accent"
	local bar = tag(mk("Frame", {
		Size = UDim2.new(0, 3, 1, -16),
		Position = UDim2.fromOffset(8, 8),
		Parent = inner,
	}), accentKind)
	build("round", bar, 2)

	-- Icono opcional según tipo
	local iconName = isSuccess and "checkcircle" or (isDanger and "alertcircle") or (isWarning and "alerttriangle") or "info"
	tag(mk("ImageLabel", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.fromOffset(18, 10),
		BackgroundTransparency = 1,
		Image = lib:GetIcon(iconName),
		Parent = inner,
	}), accentKind)

	-- Título
	build("caption", inner, {
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		Position = UDim2.fromOffset(42, 8),
		Size = UDim2.new(1, -52, 0, 16),
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, "Text")

	-- Descripción
	build("caption", inner, {
		Text = text,
		TextSize = 10,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(42, 26),
		Size = UDim2.new(1, -52, 0, 32),
	}, "TextMuted")

	-- Slide-in animación
	tween(inner, { Position = UDim2.fromOffset(0, 0) }, 0.25)
	tween(inner, { BackgroundTransparency = 0 }, 0.25)

	-- Slide-out + destroy
	task.delay(duration, function()
		if not card.Parent then return end
		tween(inner, { Position = UDim2.fromOffset(60, 0) }, 0.25)
		tween(inner, { BackgroundTransparency = 1 }, 0.25)
		task.delay(0.3, function()
			if card.Parent then card:Destroy() end
		end)
	end)

	return card
end

