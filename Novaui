			local pillLabel = build("caption", pill, {
				Text = labelText(),
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(1, -26, 1, 0),
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, "Text")
			local arrow = tag(mk("ImageLabel", {
				Size = UDim2.fromOffset(14, 14),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -5, 0.5, 0),
				BackgroundTransparency = 1,
				Image = lib:GetIcon("chevrondown"),
				Parent = pill,
			}), "TextMuted")

			local catcher = mk("TextButton", {
				Name = "AntiClick",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Visible = false,
				ZIndex = 50,
				Parent = gui,
			})
			local panel = mk("Frame", {
				Name = "DropdownFrame",
				Size = UDim2.fromOffset(150, 0),
				ClipsDescendants = true,
				Active = true,
				Parent = catcher,
			})
			tag(panel, "Elevated")
			build("round", panel, 6)
			build("outline", panel, "Stroke")

			local searchBox = nil
			if searchable then
				local searchRow = mk("Frame", {
					Size = UDim2.new(1, -8, 0, 24),
					Position = UDim2.fromOffset(4, 4),
					BackgroundTransparency = 1,
					Parent = panel,
				})
				searchBox = mk("TextBox", {
					Size = UDim2.fromScale(1, 1),
					BackgroundColor3 = palette.elevated,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamMedium,
					TextSize = 10,
					TextXAlignment = Enum.TextXAlignment.Left,
					PlaceholderText = "Buscar...",
					PlaceholderColor3 = palette.muted,
					TextColor3 = palette.text,
					Text = "",
					ClearTextOnFocus = false,
					Parent = searchRow,
				})
				build("round", searchBox, 4)
				tag(searchBox, "Frame", "BackgroundColor3")
				tag(searchBox, "Text")
				tag(searchBox, "TextMuted", "PlaceholderColor3")
			end

			local scroll = mk("ScrollingFrame", {
				Size = searchable and UDim2.new(1, 0, 1, -30) or UDim2.fromScale(1, 1),
				Position = searchable and UDim2.fromOffset(0, 30) or UDim2.fromOffset(0, 0),
				BackgroundTransparency = 1,
				ScrollBarThickness = 2,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				Parent = panel,
			}, {
				mk("UIPadding", {
					PaddingLeft = UDim.new(0, 4),
					PaddingRight = UDim.new(0, 4),
					PaddingTop = UDim.new(0, 4),
					PaddingBottom = UDim.new(0, 4),
				}),
				mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
			})
			tag(scroll, "ScrollBar")

			local function refreshMarks()
				for n, ui in pairs(optionUI) do
					local on = selected[n] == true
					setKind(ui.label, on and "Text" or "TextMuted")
					tween(ui.bar, {
						Size = UDim2.fromOffset(3, on and 12 or 0),
						BackgroundTransparency = on and 0 or 1,
					})
				end
				pillLabel.Text = labelText()
